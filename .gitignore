# Local-only scratch: previews and experiments live in
# ..\preview, outside this repo. This entry is a guard in case a
# preview folder is ever recreated here by mistake.
preview/

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store

# Chatbot backend secrets and tooling (chatbot/worker). The Gemini key lives
# in .dev.vars and must never be committed.
chatbot/worker/.dev.vars
chatbot/worker/node_modules/
chatbot/worker/.wrangler/
/node_modules/

# Generated by build.js from layout.html + sections/*/*.html (GitHub builds it
# on every push). Edit those files instead; run `npm run build` to preview.
index.html
